{
    "name": "simple_etl",
    "build": {
        "dockerfile": "./Dockerfile",
        "args": {}
    },
    "containerEnv": {
        "PYTHONPATH": "/workspace/src:${containerEnv:PYTHONPATH}",
        "VIRTUAL_ENV": "/workspace/.venv"
    },
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "postCreateCommand": "if [ \"$CI\" != true ]; then just init; fi",
    "waitFor": "postCreateCommand",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "upgradePackages": false,
            "nonFreePackages": false
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "mounts": [
        {
            "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.ssh",
            "target": "/tmp/.ssh",
            "type": "bind",
            "consistency": "cached"
        },
        {
            "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig",
            "target": "/tmp/.gitconfig",
            "type": "bind",
            "consistency": "cached"
        }
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "editor.tabSize": 4,
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "zsh"
                    }
                },
                // General
                "extensions.ignoreRecommendations": true,
                // Editor
                "editor.formatOnSave": true,
                "diffEditor.codeLens": true,
                "search.useGlobalIgnoreFiles": true,
                "files.autoSave": "afterDelay",
                "editor.defaultFormatter": "charliermarsh.ruff",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.fixAll": "explicit",
                        "source.organizeImports": "explicit"
                    }
                },
                "files.watcherExclude": {
                    "**/__pycache__/**": true
                },
                "files.exclude": {
                    "**/__pycache__": true
                },
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.languageServer": "Pylance",
                "python.terminal.activateEnvironment": true,
                "python.terminal.activateEnvInCurrentTerminal": true,
                // Linting
                "pylint.interpreter": [
                    "/workspace/.venv/bin/python"
                ],
                "flake8.interpreter": [
                    "/workspace/.venv/bin/python"
                ],
                "mypy-type-checker.interpreter": [
                    "/workspace/.venv/bin/python"
                ],
                // Formatting with Ruff
                "ruff.enable": true,
                "ruff.organizeImports": true,
                "ruff.fixAll": true,
                "ruff.lint.enable": true,
                "ruff.interpreter": [
                    "/workspace/.venv/bin/python"
                ],
                "ruff.path": [
                    "/workspace/.venv/bin/ruff"
                ],
                // Analysis
                "python.analysis.extraPaths": [
                    "/workspace/src"
                ],
                "python.analysis.include": [
                    "src/**"
                ],
                "python.analysis.exclude": [
                    "**/__pycache__",
                    ".venv/**",
                    ".git/**"
                ],
                "python.analysis.autoSearchPaths": true,
                "python.analysis.autoFormatStrings": true,
                "python.analysis.autoImportCompletions": true,
                "python.analysis.completeFunctionParens": true,
                "python.analysis.diagnosticMode": "workspace",
                "python.analysis.inlayHints.callArgumentNames": "partial",
                "python.analysis.typeCheckingMode": "strict",
                "python.analysis.useLibraryCodeForTypes": true,
                // Testing
                "python.testing.pytestEnabled": true,
                "python.testing.pytestPath": "/workspace/.venv/bin/pytest",
                "python.analysis.inlayHints.pytestParameters": true,
                "python.testing.unittestEnabled": false,
                "python.testing.nosetestsEnabled": false,
                "python.testing.autoTestDiscoverOnSaveEnabled": true
            },
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "editorconfig.editorconfig",
                "ms-python.python",
                "ms-python.pylint",
                "ms-python.mypy-type-checker",
                "ms-python.vscode-pylance",
                "neptunedesign.vs-sequential-number",
                "tamasfe.even-better-toml",
                "pomdtr.excalidraw-editor",
                "charliermarsh.ruff",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.vscode-jupyter-slideshow"
            ]
        }
    }
}